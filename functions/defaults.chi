fn greet(name: string, greeting: string = "Hello"): string {
    "$greeting, $name!"
}

fn repeatStr(s: string, n: int = 3): string {
    var result = ""
    var i = 0
    while i < n {
        result = result + s
        i = i + 1
    }
    result
}

println(greet("Alice"))
println(greet("Bob", "Hi"))
println(greet("Charlie", "Hey"))

println(repeatStr("ab"))
println(repeatStr("x", 5))
println(repeatStr("!", 1))
