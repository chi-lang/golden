// Named functions without a return type annotation return unit.
// Return values and the trailing expression are evaluated, then discarded.
fn greet(name: string) {
    if name == "" {
        return "stranger"
    }
    "hello " + name
}

println(greet(""))
println(greet("world"))

// The return value and trailing expression are discarded here too.
fn abs(n: int) {
    if n < 0 {
        return -n
    }
    n
}

println(abs(-5))
println(abs(3))
println(abs(0))
