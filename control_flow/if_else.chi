// if as expression
val x = 10
val label = if x > 5 { "big" } else { "small" }
println(label)

// nested if
fn classify(n: int): string {
    if n < 0 {
        "negative"
    } else if n == 0 {
        "zero"
    } else if n < 10 {
        "small"
    } else {
        "large"
    }
}

println(classify(-5))
println(classify(0))
println(classify(7))
println(classify(100))

// if without else (unit branch)
fn printIfPositive(n: int) {
    if n > 0 {
        println("positive: $n")
    }
}

printIfPositive(5)
printIfPositive(-3)
printIfPositive(0)
