fn classify(n: int): string {
    when {
        n < 0 -> { "negative" }
        n == 0 -> { "zero" }
        n < 10 -> { "small" }
        else -> { "large" }
    }
}

println(classify(-5))
println(classify(0))
println(classify(7))
println(classify(100))

// when with is type checking
fn describeNum(x: int | float): string {
    when {
        x is int -> { "int: ${x as int}" }
        x is float -> { "float: ${x as float}" }
        else -> { "unknown" }
    }
}

val a: int | float = 42
val b: int | float = 2.71
println(describeNum(a))
println(describeNum(b))

// when as value in assignment
val label = when {
    classify(5) == "small" -> { "yes small" }
    else -> { "not small" }
}
println(label)
