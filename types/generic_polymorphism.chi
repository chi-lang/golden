// Generic identity function — called with different types
fn identity[T](x: T): T { x }

println(identity(42))
println(identity("hello"))
println(identity(true))

// Generic pair function
fn first[A, B](a: A, b: B): A { a }
fn second[A, B](a: A, b: B): B { b }

println(first(1, "x"))
println(second(1, "x"))
println(first("a", 99))
println(second("a", 99))
