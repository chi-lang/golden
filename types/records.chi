val nested = { inner: { a: 1, b: 2 }, name: "test" }
println(nested.inner.a)
println(nested.inner.b)
println(nested.name)

// record as function argument
fn area(r: { width: int, height: int }): int {
    r.width * r.height
}
val rect = { width: 5, height: 3 }
println(area(rect))
